# Local development identity only. Never deploy with AUTH_MODE=dev.
NEXTJS_ENV=development
AUTH_MODE=dev
DEV_USER_EMAIL=developer@example.test
DEV_USER_NAME=Developer
WORKSPACE_ID=default

AI_ENABLED=false
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_ID=
AI_PROVIDER=openai
AI_MODEL=
AI_GATEWAY_TOKEN=

WHATSAPP_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WHATSAPP_TABLE=messages
WHATSAPP_GROUP_NAME_COLUMN=group_name
WHATSAPP_GROUP_COLUMN=group_id
WHATSAPP_ID_COLUMN=id
WHATSAPP_AT_COLUMN=created_at
WHATSAPP_FROM_COLUMN=sender_name
WHATSAPP_TEXT_COLUMN=body
WHATSAPP_FROM_ME_COLUMN=from_me

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=

# Local testing only: generate a separate random key (at least 32 characters).
# Production: use a Cloudflare Worker Secret. Provider API keys are set inside the app.
INTEGRATION_SECRET_KEY=
